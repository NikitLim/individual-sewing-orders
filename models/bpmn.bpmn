<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_IndividualSewing" targetNamespace="http://individual-sewing.example/kt2" exporter="Camunda Modeler" exporterVersion="5.0">
  <bpmn:process id="Process_Order" name="Оформление заказа на индивидуальный пошив" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Order">
      <bpmn:lane id="l_customer" name="Заказчик">
        <bpmn:flowNodeRef>n_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_gw_approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_manager" name="Мастер-приёмщик">
        <bpmn:flowNodeRef>n_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_gw_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_gw_material</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_cost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_proposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_replace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_change</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_tech" name="Конструктор/технолог">
        <bpmn:flowNodeRef>n_tech</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_sewer" name="Исполнитель пошива">
        <bpmn:flowNodeRef>n_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start" name="Получена заявка"/>
    <bpmn:task id="n_apply" name="Передать заявку на пошив"/>
    <bpmn:task id="n_reg" name="Зарегистрировать заказ и клиента"/>
    <bpmn:task id="n_measure" name="Зафиксировать мерки и требования"/>
    <bpmn:serviceTask id="n_complete" name="Проверить комплектность заказа"/>
    <bpmn:exclusiveGateway id="n_gw_complete" name="Данные полные?"/>
    <bpmn:serviceTask id="n_materials" name="Проверить обеспеченность заказа материалами"/>
    <bpmn:exclusiveGateway id="n_gw_material" name="Материалы есть?"/>
    <bpmn:serviceTask id="n_cost" name="Рассчитать стоимость заказа"/>
    <bpmn:task id="n_tech" name="Подготовить конструкцию и технологию"/>
    <bpmn:task id="n_proposal" name="Передать проект заказа на согласование"/>
    <bpmn:task id="n_approve" name="Согласовать стоимость, материалы и срок"/>
    <bpmn:exclusiveGateway id="n_gw_approve" name="Согласовано?"/>
    <bpmn:serviceTask id="n_form" name="Сформировать производственное задание"/>
    <bpmn:task id="n_receive" name="Принять задание в производство"/>
    <bpmn:endEvent id="n_end" name="Задание передано"/>
    <bpmn:task id="n_clarify" name="Уточнить недостающие сведения"/>
    <bpmn:task id="n_replace" name="Уточнить материал или остаток"/>
    <bpmn:task id="n_change" name="Изменить параметры по замечаниям"/>
    <bpmn:sequenceFlow id="f_0" sourceRef="n_start" targetRef="n_apply"/>
    <bpmn:sequenceFlow id="f_1" sourceRef="n_apply" targetRef="n_reg"/>
    <bpmn:sequenceFlow id="f_2" sourceRef="n_reg" targetRef="n_measure"/>
    <bpmn:sequenceFlow id="f_3" sourceRef="n_measure" targetRef="n_complete"/>
    <bpmn:sequenceFlow id="f_4" sourceRef="n_complete" targetRef="n_gw_complete"/>
    <bpmn:sequenceFlow id="f_5" sourceRef="n_gw_complete" targetRef="n_materials" name="Да"/>
    <bpmn:sequenceFlow id="f_6" sourceRef="n_gw_complete" targetRef="n_clarify" name="Нет"/>
    <bpmn:sequenceFlow id="f_7" sourceRef="n_clarify" targetRef="n_measure"/>
    <bpmn:sequenceFlow id="f_8" sourceRef="n_materials" targetRef="n_gw_material"/>
    <bpmn:sequenceFlow id="f_9" sourceRef="n_gw_material" targetRef="n_cost" name="Да"/>
    <bpmn:sequenceFlow id="f_10" sourceRef="n_gw_material" targetRef="n_replace" name="Нет"/>
    <bpmn:sequenceFlow id="f_11" sourceRef="n_replace" targetRef="n_materials"/>
    <bpmn:sequenceFlow id="f_12" sourceRef="n_cost" targetRef="n_tech"/>
    <bpmn:sequenceFlow id="f_13" sourceRef="n_tech" targetRef="n_proposal"/>
    <bpmn:sequenceFlow id="f_14" sourceRef="n_proposal" targetRef="n_approve"/>
    <bpmn:sequenceFlow id="f_15" sourceRef="n_approve" targetRef="n_gw_approve"/>
    <bpmn:sequenceFlow id="f_16" sourceRef="n_gw_approve" targetRef="n_form" name="Да"/>
    <bpmn:sequenceFlow id="f_17" sourceRef="n_gw_approve" targetRef="n_change" name="Нет"/>
    <bpmn:sequenceFlow id="f_18" sourceRef="n_change" targetRef="n_measure"/>
    <bpmn:sequenceFlow id="f_19" sourceRef="n_form" targetRef="n_receive"/>
    <bpmn:sequenceFlow id="f_20" sourceRef="n_receive" targetRef="n_end"/>
    <bpmn:dataObject id="d_request_obj" name="Заявка клиента"/>
    <bpmn:dataObjectReference id="d_request" dataObjectRef="d_request_obj" name="Заявка клиента"/>
    <bpmn:dataObject id="d_card_obj" name="Карточка клиента и заказа"/>
    <bpmn:dataObjectReference id="d_card" dataObjectRef="d_card_obj" name="Карточка клиента и заказа"/>
    <bpmn:dataObject id="d_measures_obj" name="Мерки изделия"/>
    <bpmn:dataObjectReference id="d_measures" dataObjectRef="d_measures_obj" name="Мерки изделия"/>
    <bpmn:dataObject id="d_materials_obj" name="Ведомость материалов"/>
    <bpmn:dataObjectReference id="d_materials" dataObjectRef="d_materials_obj" name="Ведомость материалов"/>
    <bpmn:dataObject id="d_spec_obj" name="Спецификация заказа"/>
    <bpmn:dataObjectReference id="d_spec" dataObjectRef="d_spec_obj" name="Спецификация заказа"/>
    <bpmn:dataObject id="d_task_obj" name="Производственное задание"/>
    <bpmn:dataObjectReference id="d_task" dataObjectRef="d_task_obj" name="Производственное задание"/>
    <bpmn:association id="assoc_0" sourceRef="n_apply" targetRef="d_request" associationDirection="None"/>
    <bpmn:association id="assoc_1" sourceRef="n_reg" targetRef="d_card" associationDirection="None"/>
    <bpmn:association id="assoc_2" sourceRef="n_measure" targetRef="d_measures" associationDirection="None"/>
    <bpmn:association id="assoc_3" sourceRef="n_materials" targetRef="d_materials" associationDirection="None"/>
    <bpmn:association id="assoc_4" sourceRef="n_tech" targetRef="d_spec" associationDirection="None"/>
    <bpmn:association id="assoc_5" sourceRef="n_form" targetRef="d_task" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Order">
    <bpmn:participant id="Participant_Atelier" name="Ателье / заказчик" processRef="Process_Order"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_Order">
